{
  "name": "reelrecs",
  "version": "1.0.0",
  "description": "ReelRecs: a hybrid RAG movie chatbot (dense + keyword search, RRF fusion, LLM reranking, cited answers)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --env-file=.env --watch server/index.js\"",
    "start": "node server/index.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "eval": "node --env-file=.env scripts/eval.js",
    "test": "node --test test/*.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "openai": "^4.60.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^8.3.4"
  },
  "license": "MIT",
  "author": "Aymane",
  "private": true
}
