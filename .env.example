OPENAI_API_KEY=sk-...
SUPABASE_URL=https://your-project.supabase.co
# Service-role key: server-side only, never expose it in the browser.
SUPABASE_SERVICE_KEY=eyJ...

# --- Optional overrides (defaults shown) ---
# PORT=3001
# LOG_LEVEL=info
# TRUST_PROXY=0              # set to 1 behind a reverse proxy so rate limiting sees real IPs
# RATE_LIMIT_PER_MIN=20

# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
# RERANK_MODEL=              # defaults to CHAT_MODEL

# Retrieval pipeline
# CANDIDATES=20              # fetched by hybrid search
# CONTEXT_SIZE=4             # passed to the LLM after reranking
# SEMANTIC_WEIGHT=1
# KEYWORD_WEIGHT=1
# RRF_K=50
# RERANK_ENABLED=true
# RERANK_MIN_SCORE=4         # 0-10; below this a result is dropped (relevance gate)
# REWRITE_ENABLED=true
